#!/sbin/openrc-run

name=$RC_SVCNAME
description="donutvpn-core service"
supervisor="supervise-daemon"
command="/usr/bin/donutvpn-core"
command_args="-D /var/lib/donutvpn-core -C /etc/donutvpn-core run"
extra_started_commands="reload"

depend() {
	after net dns
}

reload() {
	ebegin "Reloading $RC_SVCNAME"
        $supervisor "$RC_SVCNAME" --signal HUP
	eend $?
}